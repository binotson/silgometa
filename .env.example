# Copy to .env.local for local development, or set these in your hosting
# provider's environment settings (Hostinger: Websites > Node.js app >
# Environment variables). Never commit real values.

# Canonical site URL used for metadata, sitemap and robots. Read at BUILD time:
# rebuild/redeploy after changing it.
NEXT_PUBLIC_SITE_URL=https://silgometa.com.ng

# Allow search engines to index the site. Set to "true" ONLY on the production
# deployment. Read at BUILD time: rebuild/redeploy after changing it.
ALLOW_INDEXING=false

# Enquiry email delivery via Hostinger SMTP (Nodemailer). Server-side only.
# Recipients are chosen on the server from the enquiry type
# (src/lib/contact-routing.ts); there is no recipient variable.
# While SMTP_PASSWORD is empty, online sending is disabled and the form offers
# visitors a pre-filled email to infor@silgometa.com.ng instead.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=infor@silgometa.com.ng
# Password of the infor@silgometa.com.ng mailbox. Set it only in the host's
# environment settings or your local .env.local. NEVER commit it.
# (SMTP_PASS is also accepted.)
SMTP_PASSWORD=
# Sender. Must be the same mailbox as SMTP_USER (Hostinger requirement).
# (CONTACT_FROM_EMAIL=infor@silgometa.com.ng is also accepted.)
EMAIL_FROM=Silgo Meta Limited <infor@silgometa.com.ng>

# Send visitors an acknowledgement email with their reference number.
# Optional; defaults to true. Set to false to turn acknowledgements off.
CONTACT_SEND_ACKNOWLEDGEMENT=true

# Optional: name announced in the SMTP greeting. Defaults to the sender's
# domain (silgometa.com.ng). Leave unset unless advised otherwise.
# SMTP_EHLO_NAME=
