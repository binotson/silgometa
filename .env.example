# Copy to .env.local for local development, or set these in your hosting
# provider's environment settings (Hostinger: Websites > Node.js app >
# Environment variables). Never commit real values.

# Canonical site URL used for metadata, sitemap and robots. Read at BUILD time:
# rebuild/redeploy after changing it.
NEXT_PUBLIC_SITE_URL=https://silgometa.com.ng

# Allow search engines to index the site. Set to "true" ONLY on the production
# deployment. Read at BUILD time: rebuild/redeploy after changing it.
ALLOW_INDEXING=false

# Contact form email delivery via Hostinger SMTP (Nodemailer). Server-side only.
# Leave SMTP_PASS empty to keep online sending disabled; the form will then
# direct visitors to email infor@silgometa.com.ng instead.
# Recipients are chosen on the server from the enquiry type
# (src/lib/contact-routing.ts); there is no recipient variable.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=infor@silgometa.com.ng
# Password of the infor@silgometa.com.ng mailbox. Set it only in the host's
# environment settings or your local .env.local. NEVER commit it.
SMTP_PASS=
# Sender address. Must be the same mailbox as SMTP_USER (Hostinger requirement).
CONTACT_FROM_EMAIL=infor@silgometa.com.ng
