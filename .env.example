# Copy to .env.local for local development, or set these in your hosting
# provider's environment settings. Never commit real values.

# Canonical site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://www.silgometa.com.ng

# Allow search engines to index the site. Set to "true" ONLY on the production
# deployment. (On Vercel, production deployments are detected automatically.)
ALLOW_INDEXING=false

# Contact form email delivery via Resend (https://resend.com). Server-side only.
# Leave empty to keep online sending disabled; the form will then direct
# visitors to email info@silgometa.com.ng instead.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Silgo Meta Website <website@silgometa.com.ng>"
CONTACT_FROM_EMAIL=
# Recipient(s), comma-separated. Defaults to info@silgometa.com.ng.
CONTACT_TO_EMAIL=info@silgometa.com.ng
